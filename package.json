{
  "name": "@alvdigital/cwr-json-parser",
  "version": "1.3.1",
  "description": "Framework-agnostic CWR to canonical JSON parser",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./edi-preview": {
      "import": {
        "types": "./dist/edi-preview.d.ts",
        "default": "./dist/edi-preview.js"
      },
      "require": {
        "types": "./dist/edi-preview.d.cts",
        "default": "./dist/edi-preview.cjs"
      }
    },
    "./record-parser": {
      "import": {
        "types": "./dist/record-parser.d.ts",
        "default": "./dist/record-parser.js"
      },
      "require": {
        "types": "./dist/record-parser.d.cts",
        "default": "./dist/record-parser.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lookup:build": "tsx scripts/build-lookup-data.ts",
    "schema:generate": "tsx scripts/build-lookup-data.ts && tsx scripts/generate-schema.ts",
    "schema:check": "npm run schema:generate && git diff --exit-code src/cwr-sdk/json-schemas/cwr-json-schema-v1.0.schema.json src/cwr-sdk/lookups/cwr_lookup_data_types_v1.0_r0.json",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/prepare.cjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node scripts/run-tests.cjs",
    "publint": "npm run build && publint"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALVDIGITAL/cwr-json-parser.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  }
}
