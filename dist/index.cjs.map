{
  "$ref": "#/definitions/SchemaV1Output",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgreementNumber": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "CanonicalParsedCwrFile": {
      "$ref": "#/definitions/ParsedCwrFile"
    },
    "CanonicalWork": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "$ref": "#/definitions/Flags"
        },
        "identifiers": {
          "items": {
            "$ref": "#/definitions/WorkIdentifier"
          },
          "type": "array"
        },
        "messages": {
          "$ref": "#/definitions/Messages"
        },
        "parties": {
          "items": {
            "$ref": "#/definitions/Participant"
          },
          "type": "array"
        },
        "rawRecords": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recordings": {
          "items": {
            "$ref": "#/definitions/Recording"
          },
          "type": "array"
        },
        "titles": {
          "items": {
            "$ref": "#/definitions/WorkTitle"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Flags": {
      "additionalProperties": {},
      "properties": {
        "aiUsage": {
          "$ref": "#/definitions/AiUsageIndicator"
        },
        "anomalous": {
          "type": "boolean"
        },
        "fraudulent": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "HdrRecord": {
      "additionalProperties": false,
      "properties": {
        "characterSet": {
          "type": "string"
        },
        "creationDate": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "creationTime": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "revision": {
          "type": "string"
        },
        "senderIdentifier": {
          "type": "string"
        },
        "senderName": {
          "type": "string"
        },
        "softwarePackage": {
          "type": "string"
        },
        "softwarePackageVersion": {
          "type": "string"
        },
        "transmissionDate": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Messages": {
      "additionalProperties": {
        "description": "Preview / society layers may add labels here; parser may add more fields over time"
      },
      "properties": {
        "changeRequest": {
          "additionalProperties": {},
          "type": "object"
        },
        "msgs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "relinquishment": {
          "additionalProperties": false,
          "properties": {
            "indicator": {
              "type": "string"
            }
          },
          "required": [
            "indicator"
          ],
          "type": "object"
        },
        "revocation": {
          "additionalProperties": false,
          "properties": {
            "indicator": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "indicator"
          ],
          "type": "object"
        },
        "schema": {
          "type": "string"
        },
        "schemaDescription": {
          "type": "string"
        },
        "societySpecific": {
          "additionalProperties": {},
          "type": "object"
        },
        "type": {
          "$ref": "#/definitions/MessageType"
        }
      },
      "type": "object"
    },
    "ParsedCwrFile": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/definitions/HdrRecord"
        },
        "works": {
          "items": {
            "$ref": "#/definitions/CanonicalWork"
          },
          "type": "array"
        }
      },
      "required": [
        "works"
      ],
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "agreementNumber": {
          "$ref": "#/definitions/AgreementNumber"
        },
        "controlled": {
          "$ref": "#/definitions/ControlledFlag"
        },
        "ipi": {
          "type": "string",
          "pattern": "^\\d{11}$"
        },
        "name": {
          "type": "string"
        },
        "nameDomestic": {
          "type": "string"
        },
        "nameScript": {
          "type": "string"
        },
        "partyId": {
          "type": "string"
        },
        "relinquishment": {
          "$ref": "#/definitions/Relinquishment"
        },
        "representedBy": {
          "items": {
            "$ref": "#/definitions/Participant"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/definitions/RoleCode"
        },
        "roleName": {
          "type": "string"
        },
        "roleSplitM": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "roleSplitT": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "shares": {
          "items": {
            "$ref": "#/definitions/Share"
          },
          "type": "array"
        },
        "territories": {
          "items": {
            "$ref": "#/definitions/ParticipantTerritory"
          },
          "type": "array"
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "ParticipantTerritory": {
      "additionalProperties": false,
      "properties": {
        "agreementNumber": {
          "$ref": "#/definitions/AgreementNumber"
        },
        "shareTypes": {
          "items": {
            "$ref": "#/definitions/TerritoryShareType"
          },
          "type": "array"
        },
        "territory": {
          "additionalProperties": false,
          "properties": {
            "exclude": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TisNumericCode"
              }
            },
            "include": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TisNumericCode"
              }
            }
          },
          "required": [
            "include",
            "exclude"
          ],
          "type": "object"
        }
      },
      "required": [
        "territory",
        "shareTypes"
      ],
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "shareTypes": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "own"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "territory": {
                "properties": {
                  "include": {
                    "maxItems": 0
                  },
                  "exclude": {
                    "maxItems": 0
                  }
                }
              },
              "shareTypes": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "Recording": {
      "additionalProperties": false,
      "properties": {
        "isrc": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{3}\\d{7}$"
        },
        "releases": {
          "items": {
            "$ref": "#/definitions/RecordingRelease"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "RecordingRelease": {
      "additionalProperties": false,
      "properties": {
        "catno": {
          "type": "string"
        },
        "ean": {
          "type": "string",
          "pattern": "^\\d{13}$"
        },
        "identifiers": {
          "items": {
            "$ref": "#/definitions/WorkIdentifier"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Relinquishment": {
      "additionalProperties": false,
      "properties": {
        "effectiveFrom": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "note": {
          "type": "string"
        },
        "postTermCollectionUntil": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "rightsTypes": {
              "items": {
                "$ref": "#/definitions/RightsType"
              },
              "type": "array"
            },
            "territories": {
              "additionalProperties": false,
              "properties": {
                "exclude": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/TisNumericCode"
                  }
                },
                "include": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/TisNumericCode"
                  }
                }
              },
              "required": [
                "include",
                "exclude"
              ],
              "type": "object"
            }
          },
          "required": [
            "rightsTypes",
            "territories"
          ],
          "type": "object"
        }
      },
      "required": [
        "effectiveFrom",
        "scope"
      ],
      "type": "object"
    },
    "RightsType": {
      "type": "string",
      "enum": [
        "pr",
        "mr",
        "sr"
      ]
    },
    "RoleCode": {
      "type": "string",
      "enum": [
        "C",
        "A",
        "CA",
        "AR",
        "E",
        "SE",
        "AM",
        "PA",
        "AQ",
        "ES",
        "WR",
        "OP",
        "PRF"
      ]
    },
    "SchemaV1Messages": {
      "allOf": [
        {
          "$ref": "#/definitions/Messages"
        },
        {
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string"
            },
            "schemaDescription": {
              "type": "string"
            }
          },
          "required": [
            "schema",
            "schemaDescription"
          ],
          "type": "object"
        }
      ]
    },
    "SchemaV1Output": {
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/definitions/HdrRecord"
        },
        "works": {
          "items": {
            "$ref": "#/definitions/SchemaV1WorkOutput"
          },
          "type": "array"
        }
      },
      "required": [
        "works"
      ],
      "type": "object"
    },
    "SchemaV1WorkOutput": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "$ref": "#/definitions/Flags"
        },
        "identifiers": {
          "items": {
            "$ref": "#/definitions/WorkIdentifier"
          },
          "type": "array"
        },
        "messages": {
          "$ref": "#/definitions/SchemaV1Messages"
        },
        "parties": {
          "items": {
            "$ref": "#/definitions/Participant"
          },
          "type": "array"
        },
        "recordings": {
          "items": {
            "$ref": "#/definitions/Recording"
          },
          "type": "array"
        },
        "titles": {
          "items": {
            "$ref": "#/definitions/WorkTitle"
          },
          "type": "array"
        }
      },
      "required": [
        "messages"
      ],
      "type": "object"
    },
    "Share": {
      "additionalProperties": false,
      "properties": {
        "rightsType": {
          "$ref": "#/definitions/RightsType"
        },
        "society": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "rightsType",
        "value"
      ],
      "type": "object"
    },
    "TerritoryShareType": {
      "additionalProperties": false,
      "properties": {
        "shares": {
          "items": {
            "$ref": "#/definitions/Share"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "own",
            "coll"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "shares"
      ],
      "type": "object"
    },
    "WorkIdentifier": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source",
        "value"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/IdentifierSource"
        },
        "value": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "iswc"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^T-\\d{9}-\\d$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "ean"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{13}$"
              }
            }
          }
        }
      ]
    },
    "WorkTitle": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/TitleTypeCode"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
